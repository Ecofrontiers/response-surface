# EVM Wallet (secp256k1 — 0G Chain + Sepolia ENS)
EVM_PRIVATE_KEY=                      # 0x-prefixed hex, same key works for both chains
# AXL keys are separate ed25519 PEM files at axl/keys/*.pem (generated by generate-keys.sh)

# 0G Chain (testnet)
ZG_RPC=https://evmrpc-testnet.0g.ai
ZG_CHAIN_ID=16602

# 0G Compute
ZG_COMPUTE_PROVIDER=                  # Provider address from listService()

# 0G Storage
ZG_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# Sepolia (ENS)
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
ENS_PARENT_NAME=responsesurface.eth

# Astral (Base Sepolia)
ASTRAL_API=https://staging-api.astral.global
ASTRAL_CHAIN_ID=84532
ASTRAL_COMPUTE_SCHEMA=                # EAS schema UID for compute results

# Government APIs
NASA_FIRMS_KEY=                       # Free: https://firms.modaps.eosdis.nasa.gov/api/area/
EPA_AIRNOW_KEY=                       # Free: https://docs.airnowapi.org/

# Mapbox
VITE_MAPBOX_TOKEN=                    # Free tier: 50K loads/month

# AXL (paths to node configs)
AXL_FIRE_CONFIG=./axl/config-fire.json
AXL_WATER_CONFIG=./axl/config-water.json
AXL_COORD_CONFIG=./axl/config-coordinator.json
